{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Hassouna's Jarvis",
  "main": "index.js",
  "dependencies": {
    "@discord-player/extractor": "^4.5.1",
    "@discordjs/voice": "^0.18.0",
    "discord-player": "^6.7.1",
    "discord-player-youtubei": "^1.5.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prestart": "npm run build",
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop jarvis",
    "pm2:restart": "npm run build && pm2 restart jarvis",
    "pm2:logs": "pm2 logs jarvis",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
