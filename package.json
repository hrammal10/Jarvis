  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/spotify-web-api-node": "^5.0.11",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
